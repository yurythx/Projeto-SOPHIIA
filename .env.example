# =============================================================================
# VALORES DE DESENVOLVIMENTO — placeholders, NÃO são segredos reais.
#
# Em APP_ENV=production o backend (internal/platform/config) e o frontend
# (src/instrumentation.ts) RECUSAM iniciar se qualquer um destes ainda
# estiver no valor default/fraco, se DB_PASSWORD tiver < 16 caracteres, se
# DB_SSLMODE não for require|verify-ca|verify-full, ou se MINIO_PUBLIC_URL
# não for https://. Gere cada segredo por ambiente:
#   openssl rand -base64 24   # senhas
#   openssl rand -base64 48   # NEXTAUTH_SECRET
# e forneça-os por secret manager (arquivo em /run/secrets via <KEY>_FILE),
# nunca commitados.
# =============================================================================

APP_ENV=development

# Banco de Dados
DB_USER=sophiia
DB_PASSWORD=sophiia_pass
DB_NAME=sophiia
DB_PORT=5432
# dev: disable. Produção: require | verify-ca | verify-full (+ DB_SSLROOTCERT).
DB_SSLMODE=disable

# Mensageria / Filas
RABBITMQ_DEFAULT_USER=sophiia
RABBITMQ_DEFAULT_PASS=rabbit_pass
RABBITMQ_DEFAULT_VHOST=sophiia

# Keycloak / Auth OIDC
KEYCLOAK_REALM=sophiia
KEYCLOAK_CLIENT_ID=sophiia-backend
KEYCLOAK_AUDIENCE=sophiia-backend
KEYCLOAK_FRONTEND_CLIENT_ID=sophiia-frontend
# Confidencial: copie de Keycloak > Clients > sophiia-frontend > Credentials.
KEYCLOAK_FRONTEND_CLIENT_SECRET=sophiia_secret

# Autenticacao Local / Backend & NextAuth
LOCAL_AUTH_ENABLED=true
# Gere a chave de dev com `make gen-local-key`; uma por ambiente, nunca commitada.
LOCAL_AUTH_PRIVATE_KEY_FILE=/run/secrets/local_auth_private_key.pem
# Assina/cifra o cookie de sessão do NextAuth — >= 32 chars em produção.
NEXTAUTH_SECRET=super_secret_nextauth_key

# Object Storage (MinIO)
MINIO_ROOT_USER=sophiia_minio_admin
MINIO_ROOT_PASSWORD=minio_secret_password
MINIO_BUCKET=sophiia
# Produção: https:// (URLs pré-assinadas e segmentos HLS abrem no navegador).
MINIO_PUBLIC_URL=http://localhost:9000

# Cache / Buffer write-behind (Redis) — usado pelo módulo SOPHIIA
# (heartbeat do player e cache-aside de catálogo).
REDIS_URL=redis://redis:6379/0

# E-mail institucional (worker sophiia.notify.email). Deixe SMTP_HOST/FROM
# vazios em dev — o worker cai num remetente que só registra em log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
