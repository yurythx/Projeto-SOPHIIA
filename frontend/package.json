    "@vercel/otel": "^2.1.3",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-auth": "^4.24.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "swr": "^2.5.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
