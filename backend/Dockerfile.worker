# syntax=docker/dockerfile:1

# ---- builder ----
FROM golang:1.27-alpine AS builder
WORKDIR /src

RUN apk add --no-cache ca-certificates

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/worker ./cmd/worker

# ---- runtime ----
FROM alpine:3.20 AS runtime

# GIT_REVISION vem do docker-compose (build.args) / Makefile — rastreabilidade
# imagem↔commit via label OCI + ENV APP_REVISION disponível ao processo.
ARG GIT_REVISION=unknown
LABEL org.opencontainers.image.title="projeto-sophiia-worker" \
      org.opencontainers.image.source="https://github.com/yurythx/projeto-sophiia" \
      org.opencontainers.image.revision="${GIT_REVISION}"
ENV APP_REVISION=${GIT_REVISION}

# ffmpeg: transcodificação MP4 -> HLS multi-bitrate (worker de vídeo).
# ttf-dejavu: fonte usada pelo Maroto v2 na geração do PDF de certificado.
RUN apk add --no-cache ca-certificates ffmpeg ttf-dejavu

# Cria usuário não-root
RUN addgroup -g 10001 -S sophiia && adduser -u 10001 -S sophiia -G sophiia

USER sophiia
WORKDIR /app
COPY --from=builder --chown=sophiia:sophiia /out/worker ./worker

ENTRYPOINT ["./worker"]
