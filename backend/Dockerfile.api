# syntax=docker/dockerfile:1

# ---- builder ----
FROM golang:1.27-alpine AS builder
WORKDIR /src

RUN apk add --no-cache ca-certificates

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/api ./cmd/api

# ---- runtime ----
FROM alpine:3.24 AS runtime
# GIT_REVISION vem do docker-compose (build.args) / Makefile — o contexto de
# build é ./backend, sem o .git do repo, então a revisão não pode ser lida
# aqui e entra como arg. Vai pro label OCI (rastreabilidade imagem↔commit) e
# pro ENV APP_REVISION, que o processo reporta em /api/v1/monitoring/health.
ARG GIT_REVISION=unknown
LABEL org.opencontainers.image.title="projeto-sophiia-api" \
      org.opencontainers.image.source="https://github.com/yurythx/projeto-sophiia" \
      org.opencontainers.image.revision="${GIT_REVISION}"
ENV APP_REVISION=${GIT_REVISION}
RUN apk add --no-cache ca-certificates && \
    addgroup -S sophiia && adduser -S sophiia -G sophiia
USER sophiia
WORKDIR /app
COPY --from=builder --chown=sophiia:sophiia /out/api ./api

EXPOSE 8000
ENTRYPOINT ["./api"]
